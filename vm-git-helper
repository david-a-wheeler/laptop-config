#!/bin/sh
# git invokes as "vm-git-helper NAME get|store|erase" (NAME baked into
# credential.<url>.helper per host by vm-setup.sh); only "get" does anything.
[ "$2" = get ] || exit 0
token=$(secrets-client --context "$(git log -1 --oneline 2>/dev/null || echo 'non-repository or working directory')" --get "$1") || exit 1
printf 'username=x-access-token\npassword=%s\n' "$token"
